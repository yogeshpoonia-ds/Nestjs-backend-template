DATABASE_URL="postgresql://app:staging-db-password@127.0.0.1:5432/template_backend_staging"
REDIS_URL="redis://:staging-redis-password@127.0.0.1:6379"
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi

# Auth / JWT (generate secrets with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ISSUER=template-backend
JWT_AUDIENCE_ADMIN=template-backend-admin
JWT_AUDIENCE_WEB=template-backend-web
JWT_AUDIENCE_MOBILE=template-backend-mobile
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_SECURE=true
SESSION_CACHE_TTL_SECONDS=60
RBAC_CACHE_TTL_SECONDS=300

# Super Admin bootstrap (set only for bootstrap:super-admin, then remove)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=System Administrator
